FROM python:3.12-slim

WORKDIR /app

COPY backend/src/main/python/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/src/main/python/ ./
COPY data/models/modelo.pkl /app/data/models/modelo.pkl
COPY data/models/vectorizer.pkl /app/data/models/vectorizer.pkl

ENV MODEL_PATH=/app/data/models/modelo.pkl
ENV VECTORIZER_PATH=/app/data/models/vectorizer.pkl

CMD ["sh", "-c", "uvicorn predict:app --host 0.0.0.0 --port ${PORT:-5000}"]

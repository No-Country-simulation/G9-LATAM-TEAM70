# Copia este archivo como .env en el servidor OCI. No subas .env a Git.
APP_PORT=80
DB_USERNAME=techmind
DB_PASSWORD=reemplaza-por-una-contrasena-larga-y-unica
MYSQL_ROOT_PASSWORD=reemplaza-por-otra-contrasena-larga-y-unica

# Ajusta si tu instancia tiene más memoria disponible.
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
